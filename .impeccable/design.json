  "narrative": {
    "northStar": "Wayfinding",
    "overview": "Every screen of the reviewed app is a stop on a line and every string is a sign to approve. The page always answers three questions: where am I, what's left, what's next. A solid black rail carries a vertical signal-yellow line with one node per stop; the work area shows the current stop's sequence code and its strings as sign panels; a black \"Next stop\" bar sits at the bottom of the work column and turns yellow when the screen is done.\n\nThe world is built from road-sign materials: black panels, a single signal yellow, warm concrete-grey ground, square corners, thick rules, and status rendered as rotated stamps. Density is high but staged: only the current sign shows its controls, rated signs collapse to their stamp. Overpass (Highway Gothic lineage) sets everything; Overpass Mono carries codes, keys, and counts. It refuses the generic grey sidebar-list-panel tool with one blue accent.",
    "keyCharacteristics": [
      "Black rail with a 4px yellow line and circular stop nodes that fill (conic) with progress.",
      "Signal yellow reserved for \"you are here\", the current string, and arrival.",
      "Square corners everywhere except keycaps (3px) and stop nodes (round).",
      "Status as stamps (3px bordered, uppercase, rotated -3deg), never hidden.",
      "Focused sign inverts to a black panel with a 4px yellow outline.",
      "Light and dark via prefers-color-scheme; the rail stays black in both."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Yellow means \"you are here\" or \"arrived\". It never decorates; if a yellow element is not the current position, the current string, or progress toward it, it is wrong.",
        "section": "colors"
      },
      {
        "name": "The Stamp Rule",
        "body": "Status is shown by the rating colors as stamps, ticks, and filled keycaps. Those colors are not used for anything else.",
        "section": "colors"
      },
      {
        "name": "The Sign Weight Rule",
        "body": "Strings under review are always the heaviest, largest text in their panel; chrome never outweighs the copy.",
        "section": "typography"
      },
      {
        "name": "The Inversion Rule",
        "body": "To raise something, turn it into a black sign panel; don't lift it with a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep signal yellow (#ffd200) for current position, current string, progress, and arrival only.",
      "Do use square corners (0px) for every surface and control except keycaps (3px) and stop nodes (round).",
      "Do show status as stamps, ticks, or filled keycaps in the rating colors.",
      "Do raise the active element by inverting it to a black panel with a 4px yellow outline.",
      "Do set codes, keys, paths, and counts in Overpass Mono with tabular numerals.",
      "Do keep the rail black in both light and dark mode."
    ],
    "donts": [
      "Don't introduce a second accent hue; the rating and diff colors are status, not decoration.",
      "Don't add soft drop shadows to cards or buttons; the only shadows are the menu popover and the screenshot spotlight.",
      "Don't round sign panels, buttons, tags, or inputs.",
      "Don't load fonts from a CDN; Overpass and Overpass Mono ship in ui/fonts."
    ]
  }
}